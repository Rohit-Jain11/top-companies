# MySQL connection string
DATABASE_URL="mysql://root@localhost:3306/topdevelopmentco_main"

# Server
PORT=4000
NODE_ENV=development
# API_BASE_URL="http://localhost:4000"
# Production (each app on its own subdomain):
API_BASE_URL="http://localhost:4000"

# CORS - every origin allowed to call this API with credentials. Comma-separated.
#ADMIN_ORIGIN="http://localhost:3000,http://localhost:3002"
# Production:
ADMIN_ORIGIN="http://localhost:3002"

# JWT secrets - replace with long random strings in production
JWT_ACCESS_SECRET=5658e4d3c593c6ed1073451caa5e784bf25023ba720167aff647f86fda492278
JWT_REFRESH_SECRET=bac656b0b42a51159e0c68b9167f23d090e46dc9d5ac96f7931b3d9c4746bad3
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Password reset
PASSWORD_RESET_EXPIRES_IN_MINUTES=60
#ADMIN_RESET_PASSWORD_URL="http://localhost:3000/admin/reset-password"
# Production:
ADMIN_RESET_PASSWORD_URL="https://admin.topdevelopmentcompany.com/reset-password"

# Mailer (dev mode uses jsonTransport and logs to console; set SMTP_* to send real email)
